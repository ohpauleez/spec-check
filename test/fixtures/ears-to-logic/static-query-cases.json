      { "name": "large exact integer", "expr": "(= x 9007199254740993)", "expected": "sat" }
    ]
  },
  {
    "name": "broader permission has a separate inclusion verdict",
    "identifiers": ["STC-PERMISSION-BROADER", "STC-PERMISSION-NARROWER", "STC-PERMISSION-EQUIVALENT", "STC-PERMISSION-DIFFERENT"],
    "declarations": ["(declare-const x Bool)", "(declare-const y Bool)"],
    "queries": [
      { "name": "original subset generated", "expr": "(and x (not (or x y)))", "expected": "unsat" },
      { "name": "generated not subset original", "expr": "(and (or x y) (not x))", "expected": "sat" },
      { "name": "equal permission relations", "expr": "(and x (not x))", "expected": "unsat" },
      { "name": "different permissions forward", "expr": "(and x (not y))", "expected": "sat" },
