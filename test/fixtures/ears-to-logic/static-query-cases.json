    "queries": [
      { "name": "premise fails nonvacuity", "expr": "(and x (not x))", "expected": "unsat" },
      { "name": "vacuous implication query is also unsat", "expr": "(and x (not x) (not target))", "expected": "unsat" }
    ]
  },
  {
    "name": "compatible shared declarations must not be repeated",
    "identifiers": ["FLA-SPEC-DEDUP", "FLA-CLUSTER-QUERY", "STC-IMPLY-QUERY"],
